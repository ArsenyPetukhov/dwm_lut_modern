<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>DwmLutModern</RootNamespace>
    <AssemblyName>DwmLutModern</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget Condition="'$(Platform)' == ''">x64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' != ''">$(Platform)</PlatformTarget>
    <RuntimeIdentifier Condition="'$(SelfContained)' == 'true' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(SelfContained)' == 'true' and '$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>DWM LUT Modern</AssemblyTitle>
    <Product>DWM LUT Modern</Product>
    <Version>5.0.0</Version>
    <Company>dwm_lut_modern</Company>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Toast notifications for unpackaged Win32 apps need this to be false so the
         Microsoft.Toolkit.Uwp.Notifications COM activator can register. -->
    <EnableMsixTooling>false</EnableMsixTooling>
    <!-- WPF owns DPI via the manifest's PerMonitorV2 entry; suppress the WinForms analyzer's
         suggestion to move high-DPI config into ApplicationHighDpiMode (WPF ignores that). -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <DefineConstants Condition="'$(DwmLutSmokeBuild)' == 'true'">$(DefineConstants);DWM_LUT_SMOKE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.0.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WindowsDisplayAPI" Version="1.3.0.13" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\*.png" />
    <EmbeddedResource Include="Localization\*.json" />
  </ItemGroup>

  <!-- Carry the working native shader DLL next to the app output so InjectionService
       can stage it into %SystemRoot%\Temp. Built by scripts/build-release.ps1 (lutdwm.vcxproj). -->
  <ItemGroup>
    <None Include="..\..\$(Platform)\$(Configuration)\dwm_lut.dll"
          Condition="Exists('..\..\$(Platform)\$(Configuration)\dwm_lut.dll')"
          Link="dwm_lut.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
