<ui:FluentWindow x:Class="DwmLutModern.Views.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:DwmLutModern.Views"
    Title="DWM LUT Modern" Icon="/Assets/app.ico"
    Width="1120" Height="820" MinWidth="960" MinHeight="680"
    Background="{DynamicResource AppBaseBrush}" Foreground="{DynamicResource AppTextBrush}"
    WindowBackdropType="None" ExtendsContentIntoTitleBar="True"
    UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="9">
                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlassChipBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AppSelectionBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{DynamicResource AppSelectionTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AppFocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource AppBaseBrush}">
        <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="DWM LUT Modern" Height="36">
            <ui:TitleBar.Icon><Image Source="/Assets/Icons/app.png" Width="20" Height="20" /></ui:TitleBar.Icon>
        </ui:TitleBar>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="12,8,4,12" Style="{StaticResource GlassNavigation}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,10,8,20">
                        <Image Source="/Assets/Icons/app.png" Width="38" Height="38" IsHitTestVisible="False" />
                        <TextBlock Text="DWM LUT" FontWeight="SemiBold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" GroupName="Nav"
                            AutomationProperties.Name="{views:Loc Nav.Home}" AutomationProperties.AutomationId="NavDisplays"
                            IsChecked="True" Checked="NavHome_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/Icons/displays.png" Width="22" Height="22" Margin="0,0,10,0" />
                                <TextBlock Text="{views:Loc Nav.Home}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavLuts" Style="{StaticResource NavItem}" GroupName="Nav"
                            AutomationProperties.Name="{views:Loc Nav.Luts}" AutomationProperties.AutomationId="NavLuts"
                            Checked="NavLuts_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/Icons/luts.png" Width="22" Height="22" Margin="0,0,10,0" />
                                <TextBlock Text="{views:Loc Nav.Luts}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav"
                            AutomationProperties.Name="{views:Loc Nav.Settings}" AutomationProperties.AutomationId="NavSettings"
                            Checked="NavSettings_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/Icons/settings.png" Width="22" Height="22" Margin="0,0,10,0" />
                                <TextBlock Text="{views:Loc Nav.Settings}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavDocumentation" Style="{StaticResource NavItem}" GroupName="Nav"
                            AutomationProperties.Name="{views:Loc Nav.Documentation}" AutomationProperties.AutomationId="NavDocumentation"
                            Checked="NavDocumentation_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/Icons/documentation.png" Width="22" Height="22" Margin="0,0,10,0" />
                                <TextBlock Text="{views:Loc Nav.Documentation}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" GroupName="Nav"
                            AutomationProperties.Name="{views:Loc Nav.About}" AutomationProperties.AutomationId="NavAbout"
                            Checked="NavAbout_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/Icons/about.png" Width="22" Height="22" Margin="0,0,10,0" />
                                <TextBlock Text="{views:Loc Nav.About}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <TextBlock x:Name="SidebarVersion" Grid.Row="2" Margin="12,10,0,8"
                               FontSize="11" Foreground="{DynamicResource AppSecondaryTextBrush}" />
                </Grid>
            </Border>
            <Grid Grid.Column="1" Margin="6,0,12,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <ui:InfoBar x:Name="ErrorBar" Grid.Row="0" Margin="12,8,12,0"
                            Severity="Error" IsClosable="True" IsOpen="False" />
                <ContentControl x:Name="ContentHost" Grid.Row="1" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
