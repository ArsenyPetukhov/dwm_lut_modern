<ui:FluentWindow x:Class="DwmLutModern.Views.ShellWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:DwmLutModern.Views"
                 Title="DWM LUT Modern"
                 Width="1180" Height="820" MinWidth="960" MinHeight="680"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="14,0,0,0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <Border x:Name="Pill" Width="3" Height="20" CornerRadius="2"
                                        HorizontalAlignment="Left" Margin="5,0,0,0"
                                        Background="{StaticResource GlassAccentBrush}"
                                        Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#263B82F6" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#3572B7FF" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="Transparent" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Canvas IsHitTestVisible="False" Opacity="0.32">
            <Ellipse Width="560" Height="560" Canvas.Left="680" Canvas.Top="-260">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#B08B5CF6" Offset="0" />
                        <GradientStop Color="#007C3AED" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="460" Height="460" Canvas.Left="190" Canvas.Top="550">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8A38BDF8" Offset="0" />
                        <GradientStop Color="#0038BDF8" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>
        <ui:TitleBar Grid.Row="0" Title="DWM LUT Modern" Height="36">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Color24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="12,8,4,12" Style="{StaticResource GlassNavigation}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,8,8,18">
                        <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource GlassAccentBrush}">
                            <ui:SymbolIcon Symbol="Color24" Foreground="White" FontSize="21"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DWM LUT" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Color cockpit · v5" FontSize="11" Opacity="0.62" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" GroupName="Nav"
                                 AutomationProperties.Name="{views:Loc Nav.Home}"
                                 IsChecked="True" Checked="NavHome_Checked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Home24" Margin="0,0,12,0" />
                            <TextBlock Text="{views:Loc Nav.Home}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLuts" Style="{StaticResource NavItem}" GroupName="Nav"
                                 AutomationProperties.Name="{views:Loc Nav.Luts}"
                                 Checked="NavLuts_Checked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Table24" Margin="0,0,12,0" />
                            <TextBlock Text="{views:Loc Nav.Luts}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav"
                                 AutomationProperties.Name="{views:Loc Nav.Settings}"
                                 Checked="NavSettings_Checked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0" />
                            <TextBlock Text="{views:Loc Nav.Settings}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" GroupName="Nav"
                                 AutomationProperties.Name="{views:Loc Nav.About}"
                                 Checked="NavAbout_Checked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Info24" Margin="0,0,12,0" />
                            <TextBlock Text="{views:Loc Nav.About}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    </StackPanel>

                    <Border Grid.Row="2" Style="{StaticResource GlassChip}" Margin="2,8,2,2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource SystemFillColorSuccessBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Per-monitor · SDR + HDR" FontSize="11" Opacity="0.74" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="4,0,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:InfoBar x:Name="ErrorBar" Grid.Row="0" Margin="12,8,12,0"
                            Severity="Error" IsClosable="True" IsOpen="False" />

                <ContentControl x:Name="ContentHost" Grid.Row="1" Margin="0" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
