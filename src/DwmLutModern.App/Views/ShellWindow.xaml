<ui:FluentWindow x:Class="DwmLutModern.Views.ShellWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:DwmLutModern.Views"
                 Title="DWM LUT Modern"
                 Width="1080" Height="800" MinWidth="900" MinHeight="640"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Padding" Value="12,0,0,0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                            <Grid>
                                <Border x:Name="Pill" Width="3" Height="18" CornerRadius="2"
                                        HorizontalAlignment="Left" Margin="4,0,0,0"
                                        Background="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                        Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="DWM LUT Modern" Height="36">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Color24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="4,8">
                <StackPanel>
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" GroupName="Nav"
                                 IsChecked="True" Checked="NavHome_Checked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Home24" Margin="0,0,12,0" />
                            <TextBlock Text="{views:Loc Nav.Home}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLuts" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Checked="NavLuts_Checked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Table24" Margin="0,0,12,0" />
                            <TextBlock Text="{views:Loc Nav.Luts}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Checked="NavSettings_Checked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0" />
                            <TextBlock Text="{views:Loc Nav.Settings}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Checked="NavAbout_Checked">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Info24" Margin="0,0,12,0" />
                            <TextBlock Text="{views:Loc Nav.About}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:InfoBar x:Name="ErrorBar" Grid.Row="0" Margin="16,8,16,0"
                            Severity="Error" IsClosable="True" IsOpen="False" />

                <ContentControl x:Name="ContentHost" Grid.Row="1" Margin="0" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
