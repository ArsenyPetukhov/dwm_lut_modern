<UserControl x:Class="DwmLutModern.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:DwmLutModern.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,20">
        <StackPanel>
            <TextBlock Text="{views:Loc About.Title}" Style="{StaticResource PageTitle}" Margin="4,2,0,10" />
            <Border Style="{StaticResource GlassHero}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,18,0">
                    <Image Source="/Assets/Icons/app.png" Width="52" Height="52" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DWM LUT Modern" Foreground="{DynamicResource AppTextBrush}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText" Foreground="{DynamicResource AppSecondaryTextBrush}" Text="" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="OpenReleasesButton" Content="{views:Loc About.Open}" Margin="0,0,6,0"
                               Visibility="Collapsed" Click="OpenReleases_Click" />
                    <ui:Button x:Name="CheckUpdatesButton" Content="{views:Loc About.CheckUpdates}" Click="CheckUpdates_Click" />
                </StackPanel>
                <TextBlock x:Name="UpdateStatus" Grid.Row="1" Grid.ColumnSpan="2" Foreground="{DynamicResource AppSecondaryTextBrush}"
                           TextWrapping="Wrap" Margin="0,10,0,0" />
            </Grid>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,9">
                <StackPanel>
                    <TextBlock Text="{views:Loc About.Project}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85" Text="{views:Loc About.ProjectDesc}" />
                    <TextBlock Margin="0,8,0,0">
                        <Hyperlink NavigateUri="https://github.com/ArsenyPetukhov/dwm_lut_modern" RequestNavigate="Link_RequestNavigate">
                            github.com/ArsenyPetukhov/dwm_lut_modern
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,5,0,0">
                        <Hyperlink NavigateUri="https://github.com/ArsenyPetukhov/dwm_lut_modern/issues/new?template=compatibility_report.yml" RequestNavigate="Link_RequestNavigate">
                            <Run Text="{views:Loc Home.ReportHint}" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,9">
                <StackPanel>
                    <TextBlock Text="{views:Loc About.Developer}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="Arseny Petukhov" FontSize="15" />
                    <TextBlock Margin="0,8,0,0">
                        <Hyperlink NavigateUri="https://github.com/ArsenyPetukhov" RequestNavigate="Link_RequestNavigate">
                            github.com/ArsenyPetukhov
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0">
                        <Hyperlink NavigateUri="https://instagram.com/Arsenypetukhov" RequestNavigate="Link_RequestNavigate">
                            instagram.com/Arsenypetukhov
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0">
                        <Hyperlink NavigateUri="mailto:arsenypetukhov@gmail.com" RequestNavigate="Link_RequestNavigate">
                            arsenypetukhov@gmail.com
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,9">
                <StackPanel>
                    <TextBlock Text="{views:Loc About.Credits}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="{views:Loc About.CreditsText}" />
                    <TextBlock Margin="0,8,0,0">
                        <Hyperlink NavigateUri="https://github.com/lauralex/dwm_lut" RequestNavigate="Link_RequestNavigate">
                            github.com/lauralex/dwm_lut
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Opacity="0.55" FontSize="12" TextWrapping="Wrap" Margin="4,6,0,0"
                       Text="{views:Loc About.Storage}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
