<UserControl x:Class="DwmLutModern.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:DwmLutModern.ViewModels"
             xmlns:views="clr-namespace:DwmLutModern.Views"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,8,16,16">
		<StackPanel>
			<ui:InfoBar Severity="Error" IsClosable="False" Margin="0,0,0,8"
					IsOpen="{Binding HasSettingsError}"
					Message="{Binding SettingsError}" />

            <TextBlock Text="{views:Loc Settings.Appearance}" FontSize="16" FontWeight="SemiBold" Margin="4,4,0,8" />

            <ui:Card Padding="16" Margin="0,0,0,8">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{views:Loc Settings.Theme}" FontWeight="SemiBold" />
                        <TextBlock Opacity="0.7" Text="{views:Loc Settings.ThemeDesc}" />
                    </StackPanel>
                    <ComboBox HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="140"
                              ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                              ToolTip="{views:Loc Settings.ThemeDesc}" />
                </Grid>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,8">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{views:Loc Settings.Language}" FontWeight="SemiBold" />
                        <TextBlock Opacity="0.7" Text="{views:Loc Settings.LanguageDesc}" />
                    </StackPanel>
                    <ComboBox HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="180"
                              ItemsSource="{Binding Languages}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                              ToolTip="{views:Loc Settings.LanguageDesc}" />
                </Grid>
            </ui:Card>

            <TextBlock Text="{views:Loc Settings.Startup}" FontSize="16" FontWeight="SemiBold" Margin="4,16,0,8" />

            <ui:Card Padding="16" Margin="0,0,0,8">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{views:Loc Settings.StartWithWindows}" FontWeight="SemiBold" />
                        <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{views:Loc Settings.StartWithWindowsDesc}" />
                    </StackPanel>
                    <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                     IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                </Grid>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,8" IsEnabled="{Binding StartWithWindows}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{views:Loc Settings.StartMinimized}" FontWeight="SemiBold" />
                        <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{views:Loc Settings.StartMinimizedDesc}" />
                    </StackPanel>
                    <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                     IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
                </Grid>
            </ui:Card>

            <TextBlock Text="{views:Loc Settings.Hotkeys}" FontSize="16" FontWeight="SemiBold" Margin="4,16,0,8" />

            <ui:Card Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{views:Loc Settings.ToggleHotkey}" FontWeight="SemiBold" />
                        <TextBlock Opacity="0.7" Text="{views:Loc Settings.ToggleHotkeyDesc}" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="6" Padding="10,6" Margin="0,0,8,0" VerticalAlignment="Center" MinWidth="120">
                        <TextBlock Text="{Binding ToggleHotkeyText}" HorizontalAlignment="Center" />
                    </Border>
                    <ui:Button Grid.Column="2" Content="{views:Loc Action.Set}" Click="SetToggleHotkey_Click"
                               ToolTip="{views:Loc Settings.ToggleHotkeyDesc}" />
                    <ui:Button Grid.Column="3" Content="{views:Loc Action.Clear}" Margin="8,0,0,0"
                               Command="{Binding ClearToggleHotkeyCommand}" ToolTip="{views:Loc Action.Clear}" />
                </Grid>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{views:Loc Settings.CycleHotkey}" FontWeight="SemiBold" />
                        <TextBlock Opacity="0.7" Text="{views:Loc Settings.CycleHotkeyDesc}" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="6" Padding="10,6" Margin="0,0,8,0" VerticalAlignment="Center" MinWidth="120">
                        <TextBlock Text="{Binding CycleHotkeyText}" HorizontalAlignment="Center" />
                    </Border>
                    <ui:Button Grid.Column="2" Content="{views:Loc Action.Set}" Click="SetCycleHotkey_Click"
                               ToolTip="{views:Loc Settings.CycleHotkeyDesc}" />
                    <ui:Button Grid.Column="3" Content="{views:Loc Action.Clear}" Margin="8,0,0,0"
                               Command="{Binding ClearCycleHotkeyCommand}" ToolTip="{views:Loc Action.Clear}" />
                </Grid>
            </ui:Card>

            <TextBlock Text="{views:Loc Settings.Advanced}" FontSize="16" FontWeight="SemiBold" Margin="4,16,0,8" />

            <ui:Card Padding="16" Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{views:Loc Settings.DwmSupport}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DwmSupportSummary}" Opacity="0.85" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DwmSupportDetail}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:Button Content="{views:Loc Action.Recheck}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Command="{Binding RefreshDwmSupportCommand}"
                                   ToolTip="Re-read the current dwmcore.dll and check whether this Windows build has a verified profile." />
                    </Grid>

                    <Expander Header="{views:Loc Settings.CompatHeader}">
                        <StackPanel Margin="0,10,0,0">
                            <ComboBox ItemsSource="{Binding ResolverModes}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedResolverMode, Mode=TwoWay}"
                                      HorizontalAlignment="Left" MinWidth="300"
                                      ToolTip="Auto works on almost all systems. Only pick a build-specific mode if a Windows update stops the LUT from applying." />
                            <TextBlock Text="{Binding ResolverDetail}" Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ui:Card>

            <TextBlock Opacity="0.55" FontSize="12" Margin="4,8,0,0" TextWrapping="Wrap"
                       Text="{views:Loc Settings.Footer}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
