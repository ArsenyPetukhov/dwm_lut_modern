<UserControl x:Class="DwmLutModern.Views.LutLibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:DwmLutModern.ViewModels"
             xmlns:model="clr-namespace:DwmLutModern.Models"
             xmlns:views="clr-namespace:DwmLutModern.Views"
             d:DataContext="{d:DesignInstance vm:LutLibraryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,2,4,18">
            <StackPanel>
                <TextBlock Text="{views:Loc Lut.Title}" Style="{StaticResource PageTitle}" Margin="0,3,0,0" />
            </StackPanel>
            <ui:Button Content="{views:Loc Action.Import}" Appearance="Primary"
                       HorizontalAlignment="Right" Command="{Binding ImportCommand}"
                       ToolTip="{views:Loc Lut.ImportHint}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{views:Loc Lut.AssignTo}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                          HorizontalAlignment="Left" MinWidth="280">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type model:MonitorConfig}">
                            <TextBlock>
                                <Run Text="{views:Loc Common.Display}" /><Run Text=" " /><Run Text="{Binding SourceId, Mode=OneWay}" />
                                <Run Text=" · " /><Run Text="{Binding Name, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="{views:Loc Lut.Hint}" />

        <TextBlock Grid.Row="3" Text="{views:Loc Lut.Empty}"
                   Foreground="{DynamicResource AppSecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

        <ListBox Grid.Row="3" x:Name="EntryList" ItemsSource="{Binding Entries}"
                 SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 PreviewMouseMove="EntryList_PreviewMouseMove">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type model:LutEntry}">
                    <Border Style="{StaticResource GlassCard}" Padding="14,11" Margin="0,0,0,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Assets/Icons/luts.png" Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding FileName}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ui:Button Grid.Column="2" Content="{views:Loc Lut.ToSdr}" Margin="0,0,6,0"
                                       ToolTip="{views:Loc Lut.AssignSdrHint}"
                                       Command="{Binding DataContext.AssignSdrCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       CommandParameter="{Binding}" />
                            <ui:Button Grid.Column="3" Content="{views:Loc Lut.ToHdr}" Margin="0,0,6,0"
                                       ToolTip="{views:Loc Lut.AssignHdrHint}"
                                       Command="{Binding DataContext.AssignHdrCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       CommandParameter="{Binding}" />
                            <ui:Button Grid.Column="4" Content="{views:Loc Action.Remove}"
                                       ToolTip="{views:Loc Lut.RemoveHint}"
                                       Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
