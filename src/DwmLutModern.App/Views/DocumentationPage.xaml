<UserControl x:Class="DwmLutModern.Views.DocumentationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:DwmLutModern.Views">
    <ScrollViewer x:Name="DocumentScroll" VerticalScrollBarVisibility="Auto" Padding="20,16,20,20">
        <StackPanel>
            <TextBlock Text="{views:Loc Docs.Title}" Style="{StaticResource PageTitle}" Margin="2,0,0,6" />
            <TextBlock Text="{views:Loc Docs.Intro}" Style="{StaticResource PageSubtitle}" Margin="2,0,0,18" />
            <Expander Header="{views:Loc Docs.Pipeline.Title}" Tag="pipeline" IsExpanded="True" Margin="0,0,0,8"
                      AutomationProperties.AutomationId="DocPipeline">
                <TextBlock Text="{views:Loc Docs.Pipeline.Body}" TextWrapping="Wrap" LineHeight="21" Padding="12" MaxWidth="560" HorizontalAlignment="Left" />
            </Expander>
            <Expander Header="{views:Loc Docs.DirectX.Title}" Tag="directx" Margin="0,0,0,8" AutomationProperties.AutomationId="DocDirectX">
                <TextBlock Text="{views:Loc Docs.DirectX.Body}" TextWrapping="Wrap" LineHeight="21" Padding="12" MaxWidth="560" HorizontalAlignment="Left" />
            </Expander>
            <Expander Header="{views:Loc Docs.Precision.Title}" Tag="precision" Margin="0,0,0,8" AutomationProperties.AutomationId="DocPrecision">
                <TextBlock Text="{views:Loc Docs.Precision.Body}" TextWrapping="Wrap" LineHeight="21" Padding="12" MaxWidth="560" HorizontalAlignment="Left" />
            </Expander>
            <Expander Header="{views:Loc Docs.Hdr.Title}" Tag="hdr" Margin="0,0,0,8" AutomationProperties.AutomationId="DocHdr">
                <TextBlock Text="{views:Loc Docs.Hdr.Body}" TextWrapping="Wrap" LineHeight="21" Padding="12" MaxWidth="560" HorizontalAlignment="Left" />
            </Expander>
            <Expander Header="{views:Loc Docs.Dithering.Title}" Tag="dithering" Margin="0,0,0,8" AutomationProperties.AutomationId="DocDithering">
                <TextBlock Text="{views:Loc Docs.Dithering.Body}" TextWrapping="Wrap" LineHeight="21" Padding="12" MaxWidth="560" HorizontalAlignment="Left" />
            </Expander>
            <Expander Header="{views:Loc Docs.FourK.Title}" Tag="4k" Margin="0,0,0,8" AutomationProperties.AutomationId="DocFourK">
                <TextBlock Text="{views:Loc Docs.FourK.Body}" TextWrapping="Wrap" LineHeight="21" Padding="12" MaxWidth="560" HorizontalAlignment="Left" />
            </Expander>
            <Expander Header="{views:Loc Docs.Playback.Title}" Tag="playback" Margin="0,0,0,8" AutomationProperties.AutomationId="DocPlayback">
                <TextBlock Text="{views:Loc Docs.Playback.Body}" TextWrapping="Wrap" LineHeight="21" Padding="12" MaxWidth="560" HorizontalAlignment="Left" />
            </Expander>
            <Expander Header="{views:Loc Docs.Shortcuts.Title}" Tag="shortcuts" Margin="0,0,0,8" AutomationProperties.AutomationId="DocShortcuts">
                <TextBlock Text="{views:Loc Docs.Shortcuts.Body}" TextWrapping="Wrap" LineHeight="21" Padding="12" MaxWidth="560" HorizontalAlignment="Left" />
            </Expander>
            <TextBlock Text="{views:Loc Docs.Sources}" Style="{StaticResource SectionTitle}" />
            <TextBlock TextWrapping="Wrap" Margin="2,0,0,8">
                <Hyperlink NavigateUri="https://learn.microsoft.com/en-us/windows/win32/direct3ddxgi/for-best-performance--use-dxgi-flip-model" RequestNavigate="Link_RequestNavigate">
                    <Run Text="{views:Loc Docs.Microsoft}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="2,0,0,0">
                <Hyperlink NavigateUri="https://github.com/ArsenyPetukhov/dwm_lut_modern/tree/main/docs/research" RequestNavigate="Link_RequestNavigate">
                    <Run Text="{views:Loc Docs.Research}" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
