  "narrative": {
    "northStar": "Neutral calibration utility",
    "overview": "Apple-like liquid-glass restraint, expressed through native WPF and WPF-UI controls. White and dark gray keep calibration tasks legible; translucency and soft navigation depth stay subordinate to labels and state. Segoe UI is native interface typography, not a decorative display voice.",
    "keyCharacteristics": [
      "White or dark-gray ground with neutral semantic brushes.",
      "Compact labeled controls and short supporting explanations.",
      "Generated monitor/LUT identity with a quiet navigation icon family."
    ],
    "rules": [
      {
        "name": "Neutral Material",
        "body": "Use neutral surfaces, edges and interaction accents. Reserve color for meaningful status and the monitor/LUT identity.",
        "section": "colors"
      },
      {
        "name": "Shared Control",
        "body": "Reuse WPF-UI control behavior and the shared local styles; preserve visible keyboard focus and disabled states.",
        "section": "typography"
      },
      {
        "name": "Quiet Depth",
        "body": "Keep content cards on thin neutral edges; the navigation alone carries the shared soft offset shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use semantic DynamicResource brushes for both themes and Windows high contrast.",
      "Do keep settings labels beside their controls, with wrapping help beneath.",
      "Do preserve literal destinations, visible shortcut values, and matched Edit/Remove actions.",
      "Do keep technical reading at the implemented 560-DIP maximum measure."
    ],
    "donts": [
      "Don't add purple/blue ambient glows, slogans, or a replacement visual identity.",
      "Don't turn the generated icon's remaining perimeter artifacts into a material treatment.",
      "Don't replace native keyboard behavior with animated navigation or icon-only actions."
    ]
  }
}
